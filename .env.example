# ---------------------------------------------------------------------------
# TrainerIA — variables de entorno. Copiá a .env.local y completá.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # público (por ahora no se usa, reservado)
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SECRETO — solo server. NUNCA exponer al cliente.

# Whoop OAuth 2.0 (developer.whoop.com -> tu app)
# En la app de Whoop, Redirect URI (dev): http://localhost:3000/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Clave para cifrar tokens en reposo (AES-256-GCM). 32 bytes.
# Generá una con:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Cron de Vercel (opcional en dev). Generá con: openssl rand -hex 32
# En Vercel se envía como header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
